<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.localweb.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/LocalWEB.app/Contents/MacOS/localweb</string>
        <string>node</string>
        <string>--data-dir</string>
        <string>/Library/Application Support/LocalWEB</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>
    <key>StandardOutPath</key>
    <string>/var/log/localweb.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/localweb.error.log</string>
    <key>WorkingDirectory</key>
    <string>/Library/Application Support/LocalWEB</string>
    <key>UserName</key>
    <string>root</string>
    <key>GroupName</key>
    <string>wheel</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</key>
        <key>LOCALWEB_DATA_DIR</key>
        <string>/Library/Application Support/LocalWEB</string>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>