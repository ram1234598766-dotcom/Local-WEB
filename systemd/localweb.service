[Unit]
Description=LocalWEB Mesh Network Daemon
Documentation=https://github.com/ram1234598766-dotcom/Local-WEB
After=network-online.target
Wants=network-online.target

[Service]
# Type=simple, not Type=notify: the daemon has no sd_notify integration, so a
# notify unit would sit until TimeoutStartSec and be killed as a failed start.
Type=simple

# The daemon has no subcommands. The leading "node" verb is accepted and
# stripped for compatibility with the documented invocation, but the flags
# must be passed as flags.
ExecStart=/usr/bin/localweb -data-dir /var/lib/localweb
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
RestartPreventExitStatus=255
TimeoutStartSec=30
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes

# Security hardening
User=localweb
Group=localweb
DynamicUser=no
# CAP_NET_ADMIN is required for the VPN service's TUN device on Linux.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SYS_RESOURCE CAP_SYS_NICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
SystemCallFilter=@system-service @network @file-system @basic-io @process-management @cpu-time @memory-management
SystemCallErrorNumber=EPERM
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectProc=invisible
ProcSubset=pid

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
LimitMEMLOCK=infinity
LimitCORE=0

# Environment
Environment=LOCALWEB_DATA_DIR=/var/lib/localweb
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
