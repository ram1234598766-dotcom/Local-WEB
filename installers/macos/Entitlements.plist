<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Network Extension for VPN tunnel -->
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>packet-tunnel-provider</string>
        <string>app-proxy-provider</string>
    </array>
    
    <!-- Bluetooth access -->
    <key>com.apple.developer.bluetooth-central</key>
    <true/>
    <key>com.apple.developer.bluetooth-peripheral</key>
    <true/>
    
    <!-- Local network access -->
    <key>com.apple.developer.networking.multicast</key>
    <true/>
    
    <!-- File access for data storage -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    
    <!-- Network access -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    
    <!-- App groups for shared data between app and network extension -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.localweb</string>
    </array>
    
    <!-- Keychain access for identity storage -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.localweb</string>
    </array>
    
    <!-- Hardened runtime -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-executable-page-protection</key>
    <false/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <false/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <false/>
    
    <!-- Network Extension specific -->
    <key>com.apple.developer.networking.vpn.api</key>
    <array>
        <string>allow-vpn</string>
    </array>
</dict>
</plist>