# Build artifacts
/bin/
/data/
/keys/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Windows installer build output. `make msi` / `make nsis` write here; the
# .wixpdb is WiX's debug symbol file. Both are re-created by the build.
*.msi
*.wixpdb
*.wixobj
# staging directory used by scripts/build-msi.sh and build-nsis.sh
/dist/.stage/

# Test artifacts
coverage.out
coverage.html
*.test
*.prof

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Go workspace
go.work
go.work.sum

# Node identity keys (C2/C3 fix: never commit keys or data)
*.json.enc
identity.json
