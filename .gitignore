# Build artifacts
/bin/
/data/
/keys/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Linux/Android packages. These were previously committed (six copies across
# dist/ and installers/windows/, plus a 0-byte one under pkg/) and bloated every
# clone. `nfpm package` and goreleaser regenerate them from bin/, and CI builds
# its own into dist/ and uploads them as workflow artifacts.
*.deb
*.rpm
*.apk

# Release output directory. Built by `make msi` / `make nsis`, and written by CI.
# Staged documentation copies under dist/ were also committed by mistake.
/dist/

# WiX installer output. Normally lands under dist/, but listed explicitly so a
# build to a different output directory still cannot commit an installer.
*.msi
*.wixpdb
*.wixobj

# Third-party driver archives. Wintun is fetched and SHA-256 verified by
# scripts/fetch-wintun.sh rather than committed.
/installers/windows/wintun.zip

# Test artifacts
coverage.out
coverage.html
*.test
*.prof

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Go workspace
go.work
go.work.sum

# Node identity keys (C2/C3 fix: never commit keys or data)
*.json.enc
identity.json
