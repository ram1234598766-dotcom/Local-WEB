<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <?define ProductName = "LocalWEB"?>
  <?define ProductVersion = "1.0.0"?>
  <?define Manufacturer = "LocalWEB Project"?>
  <?define UpgradeCode = "{12345678-1234-1234-1234-123456789012}"?>
  <?define InstallDir = "ProgramFiles64Folder\LocalWEB"?>
  <?define SourceDir = "." ?>
  <?define IconFile = "icon.ico"?>
  <?define WintunDll = "wintun\wintun.dll"?>

  <Product Id="*" Name="$(var.ProductName)" Language="1033" Version="$(var.ProductVersion)" Manufacturer="$(var.Manufacturer)" UpgradeCode="$(var.UpgradeCode)">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" Description="LocalWEB Mesh Network Installer" Comments="Local-first encrypted mesh network" Manufacturer="$(var.Manufacturer)" Keywords="P2P,mesh,VPN,encrypted" />
    
    <MajorUpgrade DowngradeErrorMessage="A newer version of LocalWEB is already installed." Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Complete" Title="LocalWEB" Level="1" ConfigurableDirectory="INSTALLDIR">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ConfigComponents" />
      <ComponentGroupRef Id="WintunComponents" />
      <ComponentRef Id="ServiceComponent" />
      <ComponentGroupRef Id="ShortcutComponents" />
    </Feature>

    <!--
      No WixUI dialog set is referenced. Every WixUI set pulls in
      WixUI_Advanced, and in this toolset build the two collide on
      Property:WixUI_Mode, Property:DefaultUIFont, CheckBox:LicenseAccepted
      and several ControlEvents, so the package would not link at all.

      The product has one hardcoded feature and one fixed INSTALLDIR, so there
      is nothing for a wizard to choose. msiexec /i still shows the standard
      progress UI, and /qb or /qn give quiet and fully silent installs. Users
      who want a guided graphical install are served by the NSIS installer.
    -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch LocalWEB after installation" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <Binary Id="WintunDll" SourceFile="$(var.WintunDll)" />

    <!--
      ServiceInstall.ps1 configures the Wintun kernel driver and the firewall
      rules, which the WiX ServiceInstall element cannot express. The
      LocalWEB service itself is created by the native ServiceInstall element
      below, so the script only does driver and firewall work.

      These live inside Product rather than a Fragment: a CustomAction declared
      in a Fragment was silently dropped at compile time and never reached the
      linked package, leaving the driver uninstalled.

      Type 5 (Directory + Value) is the deferred form. It is used instead of a
      BinaryKey, because a BinaryKey is launched as a PE image and pointing one
      at a .ps1 fails. Property + Value is Type 51, which must be immediate.
    -->
    <CustomAction Id="ConfigureWintunAndFirewall"
                  Directory="INSTALLDIR"
                  Value='"[SystemFolder]WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "[INSTALLDIR]ServiceInstall.ps1" -Install -InstallDir "[INSTALLDIR]"'
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="RemoveWintunAndFirewall"
                  Directory="INSTALLDIR"
                  Value='"[SystemFolder]WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "[INSTALLDIR]ServiceInstall.ps1" -Uninstall -InstallDir "[INSTALLDIR]"'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="ConfigureWintunAndFirewall" After="InstallFiles">NOT Installed</Custom>
      <Custom Action="RemoveWintunAndFirewall" Before="RemoveFiles">Installed AND REMOVE="ALL"</Custom>
    </InstallExecuteSequence>
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="LocalWEB">
          <Directory Id="ScriptsDir" Name="scripts" />
          <Directory Id="WintunDir" Name="wintun" />
          <Directory Id="ConfigDir" Name="config" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="LocalWEB" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
      <Directory Id="SystemFolder" Name="System32">
        <Directory Id="DriversDir" Name="drivers" />
      </Directory>
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLDIR">
      <Component Id="LocalWebExe" Guid="{11111111-1111-1111-1111-111111111111}">
        <File Id="localweb.exe" Name="localweb.exe" Source="localweb.exe" KeyPath="yes" Checksum="yes" />
      </Component>
      <Component Id="LocalWebCliExe" Guid="{22222222-2222-2222-2222-222222222222}">
        <File Id="localweb_cli.exe" Name="localweb-cli.exe" Source="localweb-cli.exe" KeyPath="yes" Checksum="yes" />
      </Component>
      <Component Id="Readme" Guid="{33333333-3333-3333-3333-333333333333}">
        <File Id="README.md" Source="README.md" />
      </Component>
      <Component Id="License" Guid="{44444444-4444-4444-4444-444444444444}">
        <File Id="LICENSE" Source="LICENSE" />
      </Component>
      <Component Id="Changelog" Guid="{55555555-5555-5555-5555-555555555555}">
        <File Id="CHANGELOG.md" Source="CHANGELOG.md" />
      </Component>
      <Component Id="ServiceScript" Guid="{BBBBBBBB-BBBB-BBBB-BBBB-BBBBBBBBBBBB}">
        <File Id="ServiceInstall.ps1" Source="ServiceInstall.ps1" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- ConfigDir is not under INSTALLDIR, so it needs its own ComponentGroup
       rather than a Directory override on the Component (which WiX rejects). -->
  <Fragment>
    <ComponentGroup Id="ConfigComponents" Directory="ConfigDir">
      <Component Id="ConfigFile" Guid="{66666666-6666-6666-6666-666666666666}">
        <File Id="config.json" Source="config\config.json" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="WintunComponents" Directory="WintunDir">
      <Component Id="WintunDll" Guid="{77777777-7777-7777-7777-777777777777}">
        <File Id="wintun.dll" Source="$(var.WintunDll)" KeyPath="yes" Checksum="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="ServiceComponent" Guid="{88888888-8888-8888-8888-888888888888}" Directory="INSTALLDIR">
      <ServiceInstall Id="LocalWEBService" Type="ownProcess" Name="LocalWEB" DisplayName="LocalWEB Mesh Network" Description="Local-first encrypted mesh network daemon" Start="auto" Account="LocalSystem" ErrorControl="normal" Interactive="no" Arguments="node --data-dir C:\ProgramData\LocalWEB" Vital="yes" />
      <ServiceControl Id="LocalWEBServiceControl" Name="LocalWEB" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart" ResetPeriodInDays="1" ServiceName="LocalWEB" />
    </Component>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ShortcutComponents">
      <Component Id="StartMenuShortcut" Guid="{99999999-9999-9999-9999-999999999999}" Directory="ProgramMenuDir">
        <Shortcut Id="LocalWEBStartMenu" Name="LocalWEB" Description="Start LocalWEB node" Target="[INSTALLDIR]localweb.exe" Arguments="node" WorkingDirectory="INSTALLDIR" />
        <Shortcut Id="LocalWEBCLIStartMenu" Name="LocalWEB CLI" Description="LocalWEB command line interface" Target="[INSTALLDIR]localweb-cli.exe" WorkingDirectory="INSTALLDIR" />
        <Shortcut Id="UninstallStartMenu" Name="Uninstall LocalWEB" Description="Uninstall LocalWEB" Target="[System64Folder]msiexec.exe" Arguments="/x [ProductCode]" />
        <RemoveFolder Id="ProgramMenuDir" On="uninstall" />
      </Component>
      <Component Id="DesktopShortcut" Guid="{AAAAAAAA-AAAA-AAAA-AAAA-AAAAAAAAAAAA}" Directory="DesktopFolder">
        <Shortcut Id="DesktopShortcut" Name="LocalWEB" Description="Start LocalWEB node" Target="[INSTALLDIR]localweb.exe" Arguments="node" WorkingDirectory="INSTALLDIR" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Property Id="ARPCOMMENTS">Local-first encrypted mesh network</Property>
    <Property Id="ARPCONTACT">LocalWEB Project</Property>
    <Property Id="ARPURLINFOABOUT">https://github.com/ram1234598766-dotcom/Local-WEB</Property>
    <Property Id="ARPHELPLINK">https://github.com/ram1234598766-dotcom/Local-WEB/issues</Property>
    <Property Id="ARPURLUPDATEINFO">https://github.com/ram1234598766-dotcom/Local-WEB/releases</Property>
    <Property Id="ARPNOREPAIR">1</Property>
    <Property Id="ARPNOREMOVE">0</Property>
  </Fragment>
</Wix>